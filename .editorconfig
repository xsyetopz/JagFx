root = true

# ===-----------------------------------------------------------------------===
# REPOSITORY-WIDE DEFAULTS
# ===-----------------------------------------------------------------------===

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# ===-----------------------------------------------------------------------===
# KOTLIN
# ===-----------------------------------------------------------------------===

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# ===-----------------------------------------------------------------------===
# XML FILES
# ===-----------------------------------------------------------------------===

[*.{xml,plist}]
indent_size = 2
max_line_length = 100

# ===-----------------------------------------------------------------------===
# STRUCTURED DATA
# ===-----------------------------------------------------------------------===

[*.{json,yml,yaml}]
indent_size = 2

# ===-----------------------------------------------------------------------===
# SHELL SCRIPTS
# ===-----------------------------------------------------------------------===

[*.sh]
end_of_line = lf

# ===-----------------------------------------------------------------------===
# MARKDOWN
# ===-----------------------------------------------------------------------===

[*.md]
trim_trailing_whitespace = true

# >>> bedrock
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

[*.{yml,yaml,md,mdx}]
indent_style = space

[{justfile,*.just}]
indent_style = space
indent_size = 4

# Markdown marks a hard line break with two trailing spaces.
[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
# <<< bedrock

# >>> typescript-bedrock
[*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc}]
indent_style = tab
indent_size = 2
max_line_length = 80
# <<< typescript-bedrock

# ktlint_official indents Kotlin with four spaces; the bedrock defaults above would make it tabs.
[*.{kt,kts}]
indent_style = space
indent_size = 4
