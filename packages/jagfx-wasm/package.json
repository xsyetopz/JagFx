{
  "name": "@xsyetopz/jagfx-wasm",
  "version": "3.0.0",
  "description": "Browser WebAssembly bindings for JagFx, built on Kotlin/Wasm.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src"
  ],
  "scripts": {
    "test": "bun test test/index.test.mjs",
    "build:kotlin": "../../gradlew -p ../.. :bindings:syncNpmPackages",
    "playground": "bun playground/serve.mjs",
    "build:esm": "bun build ./src/index.ts --target=node --format=esm --packages=external --outfile=./dist/index.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:esm && bun run build:types"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "source": "./src/index.ts"
}
