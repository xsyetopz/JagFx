# Release artifacts collected by the justfile
publish/

# ===-----------------------------------------------------------------------===
# IDE / Editor
# ===-----------------------------------------------------------------------===
.vs/
.idea/
*.suo
*.user

# VS Code — track shared settings only
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace
*.vsix

# ===-----------------------------------------------------------------------===
# OS files
# ===-----------------------------------------------------------------------===
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ===-----------------------------------------------------------------------===
# Environment & secrets
# ===-----------------------------------------------------------------------===
.env
*.env.local

# ===-----------------------------------------------------------------------===
# Node.js
# ===-----------------------------------------------------------------------===
node_modules/
dist/
coverage/
!references/coverage/
packages/*/bun.lock
packages/*/bun.lockb
# Kotlin/JS library output, copied in by `./gradlew :bindings:syncNpmPackages`
packages/*/kotlin/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===-----------------------------------------------------------------------===
# Temporary / swap files
# ===-----------------------------------------------------------------------===
*~
*.tmp
*.bak
*.swp
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]*.un~

# ===-----------------------------------------------------------------------===
# Project-specific
# ===-----------------------------------------------------------------------===
.serena/
.cursorignore
.cursorindexingignore

# Codebase MCP
.codebase-memory/

# ===-----------------------------------------------------------------------===
# Gradle / Kotlin Multiplatform
# ===-----------------------------------------------------------------------===
.gradle/
.kotlin/
build/
!**/src/**/build/
local.properties
*.iml
iosApp/**/xcuserdata/
iosApp/**/*.xcworkspace/xcuserdata/

